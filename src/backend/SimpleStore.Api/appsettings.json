{
  "ConnectionStrings": {
    "SimpleStore": "Server=localhost;Database=SimpleStore;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "OperationalLogging": {
    "Enabled": true,
    "Path": "",
    "RetentionDays": 14,
    "FileSizeLimitBytes": 52428800
  },
  "Readiness": {
    "SqlTimeoutSeconds": 5
  },
  "AllowedHosts": "*"
}
